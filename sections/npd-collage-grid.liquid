{% comment %}
  NPD Collage Grid
  Desktop: Large left image, two stacked right
  Mobile: Slider with arrows (no manual scroll)
{% endcomment %}

{% assign order = "left_large,right_top,right_bottom,right_bottom_2" | split: "," %}

<div class="npd-collage-wrap" data-npd-collage>
  <div class="npd-collage-shell">

    <!-- Mobile arrows (overlay) -->
    <button class="npd-slider-nav npd-prev" type="button" aria-label="Previous">‹</button>
    <button class="npd-slider-nav npd-next" type="button" aria-label="Next">›</button>

    <!-- Track (this is what moves on mobile) -->
    <div class="npd-track">
      {%- for key in order -%}
        {%- for block in section.blocks -%}
          {%- if block.type == key -%}
            <div class="npd-item npd-item-{{ block.type }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                      loading: 'lazy',
                      class: 'npd-bg',
                      alt: block.settings.heading
                }}
              {% endif %}

              {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
                <div class="npd-overlay">
                  {% if block.settings.heading != blank %}
                    <h2 class="npd-heading">{{ block.settings.heading }}</h2>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="npd-text">{{ block.settings.text }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank %}
                    <a class="npd-button" href="{{ block.settings.button_link }}">
                      {{ block.settings.button_label }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
/* ===== Desktop collage layout ===== */
.npd-collage-wrap { width: 100%; }

.npd-collage-shell{
  position: relative;
  width: 100%;
  overflow: hidden; /* needed for mobile slider too */
  border-radius: 14px;
}

/* track is GRID on desktop */
.npd-track{
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  grid-template-rows:1fr 1fr;
  gap:10px;
  width:100%;
  min-height:600px;
  transition: transform 0.35s ease;
  will-change: transform;
}

.npd-item{
  position: relative;
  overflow: hidden;
  border-radius: 14px;
  width: 100%;
  height: 100%;
  background: #f5f5f5;
}

.npd-item-left_large{
  grid-column:1;
  grid-row:1 / span 2;
}

.npd-item-right_top{
  grid-column:2 / span 2;
  grid-row:1;
}

.npd-item-right_bottom{
  grid-column:2;
  grid-row:2;
}

.npd-item-right_bottom_2{
  grid-column:3;
  grid-row:2;
}

.npd-bg{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.npd-overlay{
  position:absolute;
  inset:0;
  padding:22px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:flex-start;
  background: rgba(0,0,0,0.22);
  color:#fff;
  gap:10px;
}

.npd-heading{ margin:0; font-size:28px; line-height:1.1; }
.npd-text{ margin:0; max-width:38ch; font-size:16px; line-height:1.35; }

.npd-button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:10px 18px;
  border-radius:4px;
  background:#fff;
  color:#000;
  text-decoration:none;
  font-weight:600;
}

/* arrows hidden on desktop */
.npd-slider-nav{ display:none; }

/* ===== Mobile slider ===== */
@media (max-width: 768px){

  /* track becomes FLEX and slides */
  .npd-track{
    display:flex;
    gap:0;
    min-height: 0;
    height: 420px;          /* avoids white gap under */
    grid-template-columns: none;
    grid-template-rows: none;
  }

  .npd-item{
    flex: 0 0 100%;
    height: 420px;
    border-radius: 14px;
  }

  .npd-overlay{
    align-items:center;
    text-align:center;
  }
  .npd-text{ max-width:30ch; }

  /* show arrows on mobile */
  .npd-slider-nav{
    display:flex;
    position:absolute;
    top:50%;
    transform: translateY(-50%);
    width:36px;
    height:36px;
    border-radius:999px;
    border:1px solid rgba(0,0,0,0.2);
    background: rgba(255,255,255,0.95);
    align-items:center;
    justify-content:center;
    z-index: 20;
    cursor:pointer;
    font-size:18px;
    padding:0;
  }
  .npd-prev{ left:10px; }
  .npd-next{ right:10px; }
}
</style>

<script>
(function () {
  function initOne(root) {
    if (!root) return;
    if (root.dataset.npdInit === "1") return;
    root.dataset.npdInit = "1";

    const shell = root.querySelector('.npd-collage-shell');
    const track = root.querySelector('.npd-track');
    const slides = Array.from(root.querySelectorAll('.npd-item'));
    const prev = root.querySelector('.npd-prev');
    const next = root.querySelector('.npd-next');

    if (!shell || !track || slides.length === 0 || !prev || !next) return;

    let index = 0;
    let autoplayTimer = null;
    let resumeTimer = null;
    const autoplayDelay = 3000;

    function isMobile() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function goToSlide(newIndex) {
      if (!isMobile()) return;

      if (newIndex < 0) {
        index = slides.length - 1;
      } else if (newIndex > slides.length - 1) {
        index = 0;
      } else {
        index = newIndex;
      }

      track.style.transform = `translateX(-${index * 100}%)`;

      prev.disabled = false;
      next.disabled = false;
      prev.style.opacity = '1';
      next.style.opacity = '1';
    }

    function startAutoplay() {
      stopAutoplay();

      if (!isMobile() || slides.length <= 1) return;

      autoplayTimer = window.setInterval(function () {
        goToSlide(index + 1);
      }, autoplayDelay);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function pauseThenResumeAutoplay() {
      stopAutoplay();

      if (resumeTimer) {
        window.clearTimeout(resumeTimer);
      }

      resumeTimer = window.setTimeout(function () {
        startAutoplay();
      }, autoplayDelay);
    }

    function update() {
      if (!isMobile()) {
        stopAutoplay();

        track.style.transform = 'translateX(0)';
        prev.style.display = 'none';
        next.style.display = 'none';
        index = 0;

        return;
      }

      prev.style.display = 'flex';
      next.style.display = 'flex';

      goToSlide(index);
      startAutoplay();
    }

    prev.addEventListener('click', function () {
      if (!isMobile()) return;

      goToSlide(index - 1);
      pauseThenResumeAutoplay();
    });

    next.addEventListener('click', function () {
      if (!isMobile()) return;

      goToSlide(index + 1);
      pauseThenResumeAutoplay();
    });

    window.addEventListener('resize', function () {
      index = 0;
      update();
    });

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });

    update();
  }

  function initAll() {
    document.querySelectorAll('[data-npd-collage]').forEach(initOne);
  }

  document.addEventListener('DOMContentLoaded', initAll);
  window.addEventListener('load', initAll);
})();
</script>

{% schema %}
{
  "name": "NPD Collage Grid",
  "settings": [],
  "blocks": [
    {
      "type": "left_large",
      "name": "Left Large Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "right_top",
      "name": "Right Top Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "right_bottom",
      "name": "Right Bottom Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "right_bottom_2",
