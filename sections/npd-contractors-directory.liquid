<section class="npd-contractors">
  <div class="page-width">

    <h2>{{ section.settings.heading }}</h2>

    <!-- FILTERS -->
    <div class="npd-filters">
      <select id="npd-state-filter">
        <option value="">All States</option>
      </select>

      <select id="npd-category-filter">
        <option value="">All Trades</option>
      </select>
    </div>

    <!-- GRID -->
    <div class="npd-contractors-grid" id="npd-contractors-grid">

      {% for contractor in shop.metaobjects.contractor.values %}
        <div
          class="npd-contractor-card"
          data-state="{{ contractor.state | downcase }}"
          data-category="{{ contractor.category | downcase }}"
        >

          {% if contractor.photo %}
            <img
              src="{{ contractor.photo | image_url: width: 400 }}"
              width="200"
              height="200"
              alt="{{ contractor.name }}"
            >
          {% endif %}

          <h3>{{ contractor.name }}</h3>
          <p><strong>{{ contractor.company }}</strong></p>
          <p>{{ contractor.city }}, {{ contractor.state }}</p>
          <p>{{ contractor.category }}</p>

          {% if contractor.phone != blank %}
            <a href="tel:{{ contractor.phone }}" class="npd-btn">Call</a>
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>
.npd-contractors {
  padding: 80px 0;
}

.npd-filters {
  display: flex;
  gap: 20px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.npd-filters select {
  padding: 12px 16px;
  border-radius: 8px;
  border: 1px solid #ddd;
}

.npd-contractors-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.npd-contractor-card {
  background: #fff;
  padding: 20px;
  border-radius: 14px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  text-align: center;
}

.npd-contractor-card img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 10px;
}

.npd-btn {
  display: inline-block;
  margin-top: 10px;
  padding: 8px 16px;
  background: #7c3aed;
  color: #fff;
  border-radius: 20px;
  text-decoration: none;
}

/* MOBILE */
@media (max-width: 768px) {
  .npd-contractors-grid {
    grid-template-columns: 1fr 1fr;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const stateFilter = document.getElementById("npd-state-filter");
  const categoryFilter = document.getElementById("npd-category-filter");
  const cards = document.querySelectorAll(".npd-contractor-card");

  // populate filters
  const states = new Set();
  const categories = new Set();

  cards.forEach(card => {
    states.add(card.dataset.state);
    categories.add(card.dataset.category);
  });

  states.forEach(s => {
    stateFilter.innerHTML += `<option value="${s}">${s}</option>`;
  });

  categories.forEach(c => {
    categoryFilter.innerHTML += `<option value="${c}">${c}</option>`;
  });

  function filter() {
    const s = stateFilter.value;
    const c = categoryFilter.value;

    cards.forEach(card => {
      const matchState = !s || card.dataset.state === s;
      const matchCat = !c || card.dataset.category === c;
      card.style.display = (matchState && matchCat) ? "block" : "none";
    });
  }

  stateFilter.addEventListener("change", filter);
  categoryFilter.addEventListener("change", filter);

});
</script>

{% schema %}
{
  "name": "NPD Contractors Directory",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Find Contractors",
      "label": "Heading"
    }
  ],
  "presets": [
    {
      "name": "NPD Contractors Directory"
    }
  ]
}
{% endschema %}
