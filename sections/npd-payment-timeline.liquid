<section class="bumvar-payment-section">
  <div class="page-width">

    <div class="section-header">
      <h2>PROJECT TIMELINE & PAYMENTS</h2>
    </div>

    <!-- ROW 1 -->
    <div class="bumvar-row three-columns">
      
      <div class="bumvar-card">
        <div class="card-number">Step 1</div>
        <h3>Design & Selection</h3>

        <p><strong>Select Your Finishes:</strong></p>
        <ul>
          <li>Cabinets</li>
          <li>Quartz Countertop</li>
          <li>Sink</li>
          <li>Knobs, Handles & Pulls</li>
        </ul>

        <p><strong>On-Site Design Session – Free</strong></p>
        <ul>
          <li>Cabinet sample viewing</li>
          <li>Professional measurements</li>
          <li>Blueprint delivery (3 revisions)</li>
        </ul>
      </div>

      <div class="bumvar-card">
        <div class="card-number">Step 2</div>
        <h3>Permit Application</h3>

        <ul>
          <li>Permit Application</li>
          <li>HOA application</li>
        </ul>

        <div class="payment-badge">$800</div>
      </div>

      <div class="bumvar-card">
        <div class="card-number">Step 3</div>
        <h3>Contract & Deposit</h3>

        <p><strong>Deposit: 20%</strong></p>
        <p>Example: 12 cabinet ($12,000) package → $2,400 deposit</p>

        <div class="payment-badge">20% Deposit</div>
      </div>

    </div>

    <!-- ROW 2 -->
    <div class="bumvar-row four-columns">

      <div class="bumvar-card">
        <div class="card-number">Day 1</div>
        <h3>Demolition</h3>
        <ul>
          <li><strong>Dust Containment</strong></li>
          <li>Demo</li>
        </ul>
        <div class="payment-badge">30% Payment</div>
      </div>

      <div class="bumvar-card">
        <div class="card-number">Day 2</div>
        <h3>Cabinet Installation</h3>
        <ul>
          <li><strong>Install cabinets</strong></li>
          <li>Carpentry</li>
          <li>Install hardware</li>
        </ul>
        <div class="payment-badge">30% Payment</div>
      </div>

      <div class="bumvar-card">
        <div class="card-number">Day 3</div>
        <h3>Countertop & Sink</h3>
        <ul>
          <li><strong>Install quartz</strong></li>
          <li>Install sink</li>
        </ul>
        <div class="payment-badge">10% Payment</div>
      </div>

      <div class="bumvar-card">
        <div class="card-number">Day 4</div>
        <h3>Final Adjustments & Project Completion</h3>
        <ul>
          <li>Final installation</li>
          <li><strong>Cleaning</strong></li>
        </ul>
        <div class="payment-badge">10% Payment</div>
      </div>
    </div>

    <!-- ROW 3 -->
    {% comment %} <div class="bumvar-row full-width">
      <div class="bumvar-card final-card">
        <div class="card-number">Day 5</div>
        <h3>Project Completion & Handover</h3>
        <p>Final inspection, walkthrough, and homeowner approval.</p>
        <div class="payment-badge">Final 20% Balance</div>
      </div>
    </div> {% endcomment %}

  </div>
</section>

<style>
.bumvar-payment-section {
  padding: 80px 0;
}

.section-header {
  text-align: center;
  margin-bottom: 60px;
}

.section-header h2 {
  font-size: 36px;
  margin-bottom: 10px;
}

.section-header p {
  font-size: 18px;
  color: #666;
}

/* GRID ROWS */

.bumvar-row {
  display: grid;
  gap: 30px;
  margin-bottom: 50px;
}

.two-columns {
  grid-template-columns: repeat(2, 1fr);
}

.three-columns {
  grid-template-columns: repeat(3, 1fr);
}

.four-columns {
  grid-template-columns: repeat(4, 1fr);
}

.full-width {
  grid-template-columns: 1fr;
}

/* CARDS */

.bumvar-card {
  background: #fff;
  padding: 30px;
  border-radius: 14px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.06);
  transition: 0.3s ease;
  color: inherit;
}

.bumvar-card:hover {
  transform: translateY(-4px);
}

.card-number {
  font-weight: 700;
  color: #15803d;
  margin-bottom: 10px;
}

.payment-badge {
  display: inline-block;
  margin-top: 15px;
  padding: 8px 16px;
  background: #dcfce7;
  color: #15803d;
  border-radius: 20px;
  font-weight: 600;
  font-size: 14px;
}

.payment-badge.final {
}

.final-card {
  text-align: center;
}

.final-card .payment-badge {
}

.payment-highlight {
  margin-top: 15px;
  padding: 10px;
  background: #dcfce7;
  border-radius: 8px;
  font-weight: 600;
  color: #15803d;
}

/* MOBILE */

@media (max-width: 1024px) {
  .three-columns,
  .four-columns {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .two-columns,
  .three-columns,
  .four-columns {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Payment Timeline",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "4-Day Kitchen Installation – Payment Structure"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Milestone-based payments. No chaos. No delays."
    }
  ],
  "presets": [
    {
      "name": "Payment Timeline"
    }
  ]
}
{% endschema %}